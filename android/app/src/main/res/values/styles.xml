<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- 라이트 테마라 OS 강제 다크모드의 대상이 된다. 앱이 색을 직접 관리하므로 차단. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!--
      실제 앱 화면이 쓰는 테마(BridgeActivity가 onCreate에서 이 테마로 전환한다).

      이전에는 android:background="@null"만 있고 창 배경(windowBackground)을 지정하지 않아
      창이 불투명하다고 보장되지 않았고, 실제로 시스템이 이 앱 태스크를 translucent=true로
      잡고 있었다. 반투명 태스크는 최근 앱 목록에서 복원이 실패할 수 있으므로,
      불투명한 창 배경을 명시한다.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!--
      런처(스플래시) 테마. androidx core-splashscreen의 Theme.SplashScreen을 쓸 때는
      스플래시가 끝난 뒤 전환될 테마를 postSplashScreenTheme으로 반드시 지정해야 하는데
      그게 빠져 있었다. API 31 미만 기기용 대체 배경 — 실제 아이콘까지 있는 제대로 된
      스플래시는 values-v31/styles.xml 쪽이고, 여기는 옛날 기기에서 색만이라도 맞추는 용도.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
