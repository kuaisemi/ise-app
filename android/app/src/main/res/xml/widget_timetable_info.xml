<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis는 안드로이드가 30분(1800000) 미만은 무시한다. 시간표/식단은 자주 바뀌지
  않으니 30분 주기로 충분하고, 앱에서 데이터를 고치면 WidgetBridge가 즉시 갱신해준다.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_timetable"
    android:previewLayout="@layout/widget_timetable"
    android:description="@string/widget_timetable_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
