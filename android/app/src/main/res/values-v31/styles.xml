<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      안드로이드 12(API 31)부터는 SplashScreen API가 android:windowBackground(래스터 이미지)를
      쓰지 않고, 대신 배경색 + 가운데 아이콘 조합으로 자체 스플래시를 그린다.
      배경은 처음엔 앱 아이콘과 같은 크림슨으로 했는데, 화면 가득 크림슨이 너무 강렬해서
      눈부시다는 피드백을 받아 기기의 라이트/다크 설정을 따라가는 흰/검(@color/splashBackground,
      values 대 values-night)으로 바꿨다. 아이콘은 앱 아이콘(흰색)과 달리 흰/검 배경 둘 다에서
      보여야 해서 크림슨 한 색으로 고정한 전용 아이콘(splash_icon_chip)을 쓴다.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splashBackground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_chip</item>
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
