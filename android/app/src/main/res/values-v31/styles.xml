<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      안드로이드 12(API 31)부터는 SplashScreen API가 android:windowBackground(래스터 이미지)를
      쓰지 않고, 대신 배경색 + 가운데 아이콘 조합으로 자체 스플래시를 그린다. 이 속성들을
      지정하지 않으면 기본값(테마/제조사에 따라 다른 배경색 + 런처 아이콘)이 쓰여서, 크림슨
      전체화면 이미지를 만들어도 실제로는 다른 색 배경 위에 동그란 아이콘만 뜨는 것처럼 보인다.
      그래서 배경은 앱 아이콘과 같은 크림슨으로, 아이콘은 배경이 없는(투명) 흰색 칩 심볼만
      들어있는 mipmap/ic_launcher_foreground를 그대로 써서 이음매 없이 크림슨 전체화면 + 흰
      칩 아이콘 모양이 되도록 한다.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
