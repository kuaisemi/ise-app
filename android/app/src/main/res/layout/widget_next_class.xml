<?xml version="1.0" encoding="utf-8"?>
<!-- "다음 수업" 위젯 (2x1 권장) — 지금 필요한 정보 하나만 크게 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:padding="14dp">

    <View
        android:id="@+id/next_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bar"
        android:layout_marginEnd="11dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="다음 수업"
            android:textColor="#F5C563"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/next_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/next_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#F2F4F8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/next_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                android:textColor="#8A93A6"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/next_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#6C7484"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
