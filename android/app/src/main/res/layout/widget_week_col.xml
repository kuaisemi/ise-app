<?xml version="1.0" encoding="utf-8"?>
<!-- 주간 시간표의 요일 한 칸 (요일+날짜 머리글 + 그날 수업 목록) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <TextView
        android:id="@+id/col_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/col_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="6dp"
        android:textSize="9sp" />

    <!-- 위쪽 정렬(기본값)로 둔다. 가운데 정렬로 바꿔봤더니 요일마다 수업 개수가 달라서
         첫 수업이 시작하는 높이가 제각각이 되고, 가로로 줄이 안 맞아 보였다.
         위에서부터 쌓아야 다섯 요일의 첫 줄·둘째 줄이 나란히 맞는다. -->
    <LinearLayout
        android:id="@+id/col_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
