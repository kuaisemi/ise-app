<?xml version="1.0" encoding="utf-8"?>
<!--
  주간 시간표의 수업 한 칸.
  높이는 코드에서 수업 시간(분)에 비례해 지정하므로 여기선 0dp로 두고,
  ImageView.setColorFilter는 src에만 먹으므로 둥근 배경도 src로 깐 ImageView를 뒤에 둔다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/chip_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_chip"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="3dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/chip_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#DDFFFFFF"
            android:textSize="8sp" />

        <!--
          강의실은 시간과 같은 줄을 쓰면 둘 중 하나를 못 보여준다(예전엔 강의실 표시를 켜면
          시간이 통째로 사라졌다). 줄을 따로 두고, 칸이 충분히 높을 때만 코드에서 켠다.
        -->
        <TextView
            android:id="@+id/chip_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#BBFFFFFF"
            android:textSize="8sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
