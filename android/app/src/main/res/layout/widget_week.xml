<?xml version="1.0" encoding="utf-8"?>
<!--
  "주간 시간표" 위젯 — 앱 안의 시간표 화면처럼 왼쪽 시간축 + 월~금 격자로 그린다.
  RemoteViews는 실행 중에 자식을 붙일 수 있어서(removeAllViews + addView) 요일별 수업 개수가
  달라도 대응된다. 오늘 요일 머리글만 강조색으로 표시한다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_dark"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/widget_accent"
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:src="@drawable/widget_bar"
                android:scaleType="fitXY"
                android:layout_marginEnd="7dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="주간 시간표"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp" />
        </LinearLayout>

        <!--
          시간축 열 + 월~금 다섯 열. 다섯 열 모두 코드에서 addView로 채운다.
          앱 안의 시간표처럼 수업이 실제 시각 위치에, 실제 길이만큼의 높이로 놓인다.
        -->
        <LinearLayout
            android:id="@+id/week_cols"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/week_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
