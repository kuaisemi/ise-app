<?xml version="1.0" encoding="utf-8"?>
<!--
  "달력" 위젯 — 요일 머리글과 주 단위 행을 코드에서 addView로 채운다.
  오늘 날짜는 원으로 강조하고, 일정이나 메모가 있는 날은 아래에 점을 찍는다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_dark"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/cal_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp" />

        <LinearLayout
            android:id="@+id/cal_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/cal_memo_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/cal_memo_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="@drawable/widget_bar"
                android:scaleType="fitXY"
                android:layout_marginBottom="7dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cal_memo_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘 할 일"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cal_memo_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
