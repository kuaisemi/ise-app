<?xml version="1.0" encoding="utf-8"?>
<!--
  "달력 (가로형)" 위젯 — 삼성 기본 캘린더 위젯처럼 왼쪽에 이번 달 달력, 오른쪽에 오늘 일정을
  나란히 보여준다. 세로형(widget_calendar)이 달력만 크게 보여주는 것과 달리, 이쪽은
  "이번 달 + 오늘 뭐 있지"를 한 화면에서 같이 확인하는 용도.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_dark"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="14dp">

        <!-- 왼쪽: 달력 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cal_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_marginBottom="3dp" />

            <LinearLayout
                android:id="@+id/cal_rows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>

        <ImageView
            android:id="@+id/wide_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:src="@drawable/widget_bar"
            android:scaleType="fitXY"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null" />

        <!-- 오른쪽: 오늘 날짜 + 오늘 일정/메모 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wide_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wide_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wide_ev_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wide_ev_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wide_ev_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wide_memo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
