<?xml version="1.0" encoding="utf-8"?>
<!--
  "오늘의 시간표" 위젯 (4x2 권장).
  수업 행 5개를 미리 만들어 두고 필요한 만큼만 보이게 한다 — 위젯에서 목록을 그리려면
  RemoteViewsService가 필요한데, 하루 수업은 많아야 대여섯 개라 이 편이 훨씬 가볍다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="오늘의 시간표"
            android:textColor="#F5C563"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A93A6"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="#6C7484"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 수업 행 0 -->
    <LinearLayout android:id="@+id/row_0"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
        <View android:id="@+id/bar_0" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/widget_bar" android:layout_marginEnd="9dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/subject_0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#F2F4F8" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/meta_0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#8A93A6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 수업 행 1 -->
    <LinearLayout android:id="@+id/row_1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
        <View android:id="@+id/bar_1" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/widget_bar" android:layout_marginEnd="9dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/subject_1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#F2F4F8" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/meta_1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#8A93A6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 수업 행 2 -->
    <LinearLayout android:id="@+id/row_2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
        <View android:id="@+id/bar_2" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/widget_bar" android:layout_marginEnd="9dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/subject_2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#F2F4F8" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/meta_2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#8A93A6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 수업 행 3 -->
    <LinearLayout android:id="@+id/row_3"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
        <View android:id="@+id/bar_3" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/widget_bar" android:layout_marginEnd="9dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/subject_3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#F2F4F8" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/meta_3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#8A93A6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 수업 행 4 -->
    <LinearLayout android:id="@+id/row_4"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
        <View android:id="@+id/bar_4" android:layout_width="3dp" android:layout_height="match_parent"
            android:background="@drawable/widget_bar" android:layout_marginEnd="9dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/subject_4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#F2F4F8" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/meta_4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="#8A93A6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#6C7484"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
