<?xml version="1.0" encoding="utf-8"?>
<!-- "일정 · 메모" 위젯 — 다가오는 학사일정 3개 + 오늘 메모 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_dark"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="11dp">

            <ImageView
                android:id="@+id/widget_accent"
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:src="@drawable/widget_bar"
                android:scaleType="fitXY"
                android:layout_marginEnd="7dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="다가오는 일정"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ev_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout android:id="@+id/ev_row_0"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/ev_title_0" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
                android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/ev_date_0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/ev_row_1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/ev_title_1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
                android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/ev_date_1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/ev_row_2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="7dp" android:visibility="gone">
            <TextView android:id="@+id/ev_title_2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
                android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/ev_date_2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/memo_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/memo_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:src="@drawable/widget_bar"
                android:scaleType="fitXY"
                android:layout_marginBottom="8dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/memo_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘 메모"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/memo_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
