rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCouncil() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in ['council','director','vice','president','developer'];
    }

    function isDeveloper() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'developer';
    }

    function isPresident() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in ['president','developer'];
    }

    function isDirectorPlus() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role in ['director','vice','president','developer'];
    }


    // 인증코드 원본. 클라이언트 코드에는 절대 값이 들어가지 않고, 아래 users/{uid} 규칙
    // 안에서 서버가 직접 대조한다(규칙 내부 get()은 read 권한과 무관하게 동작).
    // 문서가 아직 없을 수도 있으므로 exists()로 먼저 거른다. 없는 키를 점 표기(codes().x)로
    // 읽으면 규칙 평가 자체가 오류로 끝나 무조건 거부되기 때문에, 값은 get(키, 기본값)으로 읽는다.
    // (실제로 presidentCode·developerCode를 저장하는 코드가 없어서 회장/개발자 코드가
    //  아예 통과할 수 없던 문제가 있었다)
    function codes() {
      return exists(/databases/$(database)/documents/shared/councilCode)
        ? get(/databases/$(database)/documents/shared/councilCode).data
        : {};
    }
    // 승급하려는 직급이, 함께 제출한 코드(roleCode)와 실제로 맞는지 서버에서 확인한다.
    // submitted != '' 를 함께 보는 이유: 아직 발급되지 않은 코드의 기본값('')과 빈 입력이
    // 우연히 같아져서 통과하는 일을 막는다.
    function roleCodeValid(role, submitted) {
      return (role == 'student')
        || (role == 'council'   && submitted != '' && submitted == codes().get('code', ''))
        || (role == 'president' && submitted != '' && submitted == codes().get('presidentCode', ''))
        || (role == 'developer' && submitted != '' && submitted == codes().get('developerCode', ''));
    }

    match /users/{uid} {
      // 본인 문서는 항상, 남의 문서는 학생회 이상만(관리 화면에서 필요) 읽을 수 있다.
      // isCouncil()이 이 문서(/users/{request.auth.uid})를 다시 읽으므로, uid가 본인일
      // 때는 그 재귀 조회 없이 먼저 걸러지도록 자기 자신 조건을 앞에 둔다.
      allow read: if isSignedIn() && (request.auth.uid == uid || isCouncil());

      // 가입: 자기 문서만, 그리고 학생회 이상으로 만들려면 코드가 실제로 맞아야 한다.
      // (예전에는 필드 제한이 없어서 아무나 role:'developer'를 그냥 써넣을 수 있었다)
      //
      // 명단과 안 맞아 signupInquiries에 문의를 넣은 사람은, 국장 이상이 그 문의를
      // 승인(status:'approved')한 뒤에 한해 국장 이상이 대신 이 문서를 만들어줄 수 있다
      // (본인 Auth 계정은 가입 시도 때 이미 만들어져 있고, 여기선 프로필만 뒤늦게 붙는다).
      allow create: if isSignedIn() && (
        (request.auth.uid == uid
          && roleCodeValid(request.resource.data.role, request.resource.data.get('roleCode', '')))
        || (isDirectorPlus() && request.resource.data.role == 'student'
          && exists(/databases/$(database)/documents/signupInquiries/$(uid))
          && get(/databases/$(database)/documents/signupInquiries/$(uid)).data.status == 'approved')
      );

      allow update: if isSignedIn() && request.auth.uid == uid && (
        // 평소 수정: 직급은 그대로 두어야 한다.
        request.resource.data.role == resource.data.role
        // 자가 승급/해제: 코드가 맞을 때만. 해제(student)는 코드 없이 가능.
        || roleCodeValid(request.resource.data.role, request.resource.data.get('roleCode', ''))
      );

      // 회장 이상은 남의 직급을 바꿀 수 있다(관리자 화면).
      allow update: if isPresident()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

      // 회장이 계정을 실제로 뺄 수 있게. 예전엔 delete 규칙이 없어 삭제가 조용히 거부됐고,
      // 그래서 "탈퇴시키기"가 화면용 캐시에서만 사라지는 시늉으로 끝났다.
      // 본인 탈퇴(회원 탈퇴)도 마찬가지 이유로 막혀 있었다 — 클라이언트가 .catch(()=>{})로
      // 그 실패를 삼키고 Auth 계정만 지워버려서, Firestore에는 유령 프로필만 남았다.
      allow delete: if isPresident() || (isSignedIn() && request.auth.uid == uid);
    }

    // 최종 접속 IP처럼 학생회 부원에게도 보이면 안 되는 기록. users/{uid}에 두면 그 문서는
    // 학생회 이상 읽기가 열려 있어서 부원 전원에게 노출된다. Firestore는 한 문서 안에서
    // 필드별로 권한을 나눌 수 없으므로 문서를 아예 따로 뺀다.
    // 읽기는 본인과 개발자만, 쓰기는 본인만(각자 자기 접속 기록을 남긴다).
    match /userMeta/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isDeveloper());
      // 쓰기는 본인(자기 접속 기록을 남긴다)과 개발자(기록 정리)만.
      allow write: if isSignedIn() && (request.auth.uid == uid || isDeveloper());
    }

    // 두 uid를 사전순으로 이어붙인 키. 누가 먼저 추가했든 같은 두 사람이면 항상 같은
    // 문서 하나를 가리키게 하려고 정렬해서 합친다(문자열 비교는 규칙에서도 그냥 </<=/> 로 된다).
    function pairKey(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    // status가 'accepted'면 수락된 친구, 'pending'이면 아직 수락 대기중. 예전(수락 절차가
    // 없던 시절)에 만들어진 문서는 status 필드가 아예 없으므로, 없으면 이미 성립된 관계로
    // 본다(pending이 아닌 것만 걸러내면 됨) — 그래야 그때 만든 관계가 깨지지 않는다.
    function friendsWith(a, b) {
      let p = /databases/$(database)/documents/friendLinks/$(pairKey(a, b));
      return exists(p) && get(p).data.get('status', 'accepted') != 'pending';
    }
    // 친구여도 시간표까지 자동으로 다 보이는 건 아니다 — 친구 관계 문서 안에 "내 쪽"
    // 공개 여부(shareTimetable.{내 uid})를 따로 두고, 기본값은 켜짐(true)으로 둔다.
    // 즉 친구가 된 순간엔 공개 상태고, 원하면 이 친구에게만 나중에 꺼둘 수 있다.
    function sharesTimetableWith(ownerUid, viewerUid) {
      let p = /databases/$(database)/documents/friendLinks/$(pairKey(ownerUid, viewerUid));
      return exists(p)
        && get(p).data.get('status', 'accepted') != 'pending'
        && get(p).data.get('shareTimetable', {}).get(ownerUid, true) != false;
    }

    match /timetables/{uid} {
      // 친구가 된 사람 중, 내가 공개를 켜둔 사람만 내 시간표를 볼 수 있다. 쓰기는 여전히 본인만.
      allow read: if isSignedIn() && (request.auth.uid == uid || sharesTimetableWith(uid, request.auth.uid));
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // 친구 찾기용 최소 정보(학번·이름)만 담은 공개 명단. users/{uid}는 본인·학생회만 읽을 수
    // 있어서 일반 학생이 학번으로 서로를 찾을 방법이 없었다 — 그렇다고 users 전체를 열면
    // 직급·가입일 같은 정보까지 다 새어나가므로, 이 용도로만 쓸 아주 작은 문서를 따로 둔다.
    match /studentDirectory/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId', 'name']);
    }

    // 가입 시 명단과 안 맞은 사람이 남기는 문의. 가입 절차상 이 시점엔 이미 본인 Auth
    // 계정이 있는 상태라(그래야 나중에 승인돼도 비밀번호를 다시 받을 필요가 없다),
    // 자기 uid로만 문서 하나를 만들 수 있게 한다. 국장 이상이 승인/거절만 바꿀 수 있고,
    // 그 결과로 users/{uid} 생성이 허용되는지가 갈린다(위 users 규칙 참고).
    match /signupInquiries/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isDirectorPlus());
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentId','name','birthYear','status','createdAt'])
        && request.resource.data.status == 'pending';
      allow update: if isDirectorPlus()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt','resolvedBy']);
      allow delete: if isDirectorPlus() || (isSignedIn() && request.auth.uid == uid);
    }

    // 친구 관계 — 요청 → 수락 절차가 있다. 문서 하나가 두 사람을 모두 가리키므로(uids 배열),
    // 신청자가 자기 자신을 포함시켰는지, 문서 ID가 정말 그 두 uid를 정렬해 이어붙인 값인지를
    // 검사해서 아무나 남의 이름으로 관계를 조작해 만들 수 없게 한다.
    match /friendLinks/{pairId} {
      // 문서가 아직 없을 때(신청 전, "이미 친구인지" 확인차 읽는 경우)는 resource가 null이라
      // resource.data.uids를 그대로 읽으면 규칙 평가 자체가 오류로 끝나 permission-denied가
      // 난다 — 그래서 존재하지 않는 문서는 먼저 걸러준다(안 그래도 없는 문서라 읽어봤자 빈 결과).
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.uids);
      // 신청: 반드시 status:'pending'으로 시작하고, 신청자 본인이 requestedBy여야 한다.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] != request.resource.data.uids[1]
        && pairId == pairKey(request.resource.data.uids[0], request.resource.data.uids[1])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // 수락: 신청받은 쪽(requestedBy가 아닌 사람)만, status 필드만, pending→accepted로만.
      allow update: if isSignedIn() && request.auth.uid in resource.data.uids && (
        (request.auth.uid != resource.data.requestedBy
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        // 시간표 공개 범위 토글: shareTimetable 맵 안에서도 "내 쪽" 항목만 바꿀 수 있다
        // (상대방 몫을 내가 끄거나 켤 수는 없게).
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareTimetable'])
          && request.resource.data.shareTimetable.diff(resource.data.get('shareTimetable', {})).affectedKeys().hasOnly([request.auth.uid]))
        // 채팅 "비우기": 메시지를 실제로 지우는 게 아니라, "내 화면에서는 이 시각 이전
        // 메시지를 안 보여줘"라는 내 쪽 기준 시각만 남긴다 — 상대방 화면엔 그대로 보이고,
        // 실제 삭제는 기존 24시간 자동 정리가 그대로 처리한다.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clearedAt'])
          && request.resource.data.clearedAt.diff(resource.data.get('clearedAt', {})).affectedKeys().hasOnly([request.auth.uid]))
      );
      // 삭제: 둘 중 누구든 — 대기중이면 취소/거절, 이미 친구면 친구 삭제.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    // 두 사람만의 실시간 채팅. friendLinks와 똑같은 pairKey를 컬렉션 경로로 그대로 써서,
    // "이 채팅방이 그 두 사람 것"인지를 별도 필드 없이 경로 자체로 증명한다.
    function pairContains(pairId, uid) {
      return uid in pairId.split('_');
    }
    match /chats/{pairId}/messages/{msgId} {
      // 친구 요청이 아직 대기중이거나 끊어졌으면 과거 채팅도 더는 못 보게, 매 요청마다
      // "수락된 친구 사이"인지를 함께 확인한다(친구가 아니면 애초에 pairId 두 uid를 알아도 못 봄).
      allow read: if isSignedIn() && pairContains(pairId, request.auth.uid)
        && friendsWith(pairId.split('_')[0], pairId.split('_')[1]);
      allow create: if isSignedIn() && pairContains(pairId, request.auth.uid)
        && friendsWith(pairId.split('_')[0], pairId.split('_')[1])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt']);
      // 수정·삭제는 없음 — "채팅 비우기"는 실제로 메시지를 지우지 않고 friendLinks의
      // clearedAt(내 쪽 기준 시각)만 바꾼다. 진짜 삭제는 24시간 자동 정리가 담당한다.
      allow update, delete: if false;
    }

    // 개인 메모장 — 본인 것만 읽고 쓸 수 있다. 공용 문서(shared/*)와 달리 사용자별로
    // 문서가 나뉘어 있어서 1MiB 문서 한도도 사람당 따로 적용된다.
    match /memos/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /shared/suggestions  { allow read, write: if isSignedIn(); }
    match /shared/recruitments { allow read, write: if isSignedIn(); }
    match /shared/polls        { allow read, write: if isSignedIn(); }
    // 전체 가입자 이름 · 학번 · 직급 디렉터리 — 학부생까지 다 보이면 안 되니 학생회 이상만.
    match /shared/usersList    { allow read, write: if isCouncil(); }
    // 버그 제보엔 제보자 실명 · 학번이 들어가는데, 목록은 학생회 제보함 화면(학생회 이상)에서만
    // 보여준다. 제보 자체(쓰기)는 누구나 할 수 있어야 해서 write는 계속 열어둔다.
    match /shared/bugReports { allow read: if isCouncil(); allow write: if isSignedIn(); }
    // 친구 채팅 신고함. bugReports와 같은 모양 — 누구나 자기 신고를 추가할 수 있고
    // (전체 문서를 덮어쓰는 방식이라 완전히 안전하진 않지만 버그 제보함과 같은 수준으로 맞춤),
    // 신고함을 들여다보는 건 학생회 이상만.
    match /shared/chatReports { allow read: if isCouncil(); allow write: if isSignedIn(); }
    // 공지는 작성/수정/삭제는 클라이언트 UI에서 학생회로만 제한하지만, 학부생도 "좋아요"를
    // 누를 때 이 문서에 같이 써야 해서 쓰기 자체는 로그인한 사람 모두에게 열어둔다.
    // (suggestions/recruitments/polls도 같은 이유로 이미 열려있음 — 이 앱은 문서 단위 권한이라
    // 필드 단위로 "좋아요만" 허용하는 세밀한 제어는 하지 않는, 클라이언트를 신뢰하는 모델)
    match /shared/notices       { allow read, write: if isSignedIn(); }
    // 인증코드 — 이제 클라이언트가 값을 읽어서 대조하지 않고, users/{uid} 규칙 안에서
    // 서버가 직접 대조한다. 그래서 읽기는 코드를 발급·재발급하는 회장급만 열어둔다.
    // (학생이 로그인만 하면 코드를 그대로 읽어갈 수 있던 문제를 막는다)
    match /shared/councilCode { allow read: if isPresident(); allow write: if isPresident(); }
    // 삭제 기록(누가 · 언제 · 어디서 지웠는지) — 학생회장 이상만 볼 수 있고, 기록 자체는
    // 삭제 권한이 있는 학생회 계정이면 남길 수 있다.
    match /shared/auditLog { allow read: if isPresident(); allow write: if isCouncil(); }
    // 탈퇴 대기열. 클라이언트 SDK는 남의 Firebase Auth 계정을 지울 수 없어서(본인 것이거나
    // Admin SDK여야 한다), 회장이 탈퇴시킨 uid를 여기에 쌓아두고 서버(GitHub Actions)가
    // 대신 지운다. 지우기 전까지 그 계정은 로그인해도 명단·프로필이 없어 막힌다.
    match /shared/pendingAuthDeletes { allow read, write: if isPresident(); }
    // 사진 인식(Gemini) API 키. 예전에는 빌드할 때 키를 index.html에 끼워 넣었는데, 이 앱은
    // 웹뷰를 그대로 감싼 구조라 index.html이 배포 사이트 소스에도 APK 안에도 텍스트 그대로
    // 들어간다. "페이지 소스 보기" 한 번이면 키가 나왔고, 실제로 구글에 탐지돼 반복해서
    // 폐기됐다. 여기 두면 배포물에는 키가 남지 않고, 교체할 때 앱을 다시 빌드할 필요도 없다.
    // 읽기는 가입이 끝난(users 문서가 있는) 사람만 — 계정만 만들고 명단 검증을 통과하지
    // 않은 상태에서는 못 읽는다. 쓰기는 회장급만.
    match /shared/geminiKeys {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow write: if isPresident();
    }
    // 전체 학생 명단(실명 · 학번 · 출생연도) — 회원가입 검증 때는 아직 users/{uid} 문서가
    // 생기기 전(가입 절차 도중)이라 그 틈에만 읽게 해주고, 가입이 끝나 문서가 생긴 뒤에는
    // 학생회 이상만 읽을 수 있다. (예전엔 명시 규칙이 없어 로그인만 하면 전체가 읽혔음)
    match /shared/roster {
      allow read: if isCouncil()
        || (isSignedIn() && !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow write: if isCouncil();
    }

    // 모두가 읽어야 하는 공용 문서만 여기에 이름을 적어둔다.
    //
    // 예전에는 여기가 `match /shared/{docId}` 와일드카드로 "로그인했으면 뭐든 읽기"였는데,
    // Firestore 규칙은 여러 match가 겹치면 그중 하나라도 허용하면 통과시킨다(OR).
    // 그래서 위에서 roster·usersList·bugReports·auditLog를 아무리 좁혀놔도, 이 와일드카드
    // 하나 때문에 로그인한 학생이면 전부 읽을 수 있었다. 명단 보호가 사실상 없던 셈이라
    // 와일드카드를 없애고 공개해도 되는 문서만 하나씩 나열한다.
    match /shared/calendarEvents { allow read: if isSignedIn(); allow write: if isCouncil(); }
    match /shared/councilPosts   { allow read: if isSignedIn(); allow write: if isSignedIn(); }
    match /shared/deptNotices    { allow read: if isSignedIn(); allow write: if isCouncil(); }
    match /shared/meals          { allow read: if isSignedIn(); allow write: if isCouncil(); }
    match /shared/fetchState     { allow read: if isSignedIn(); allow write: if isCouncil(); }
    match /shared/notifyState    { allow read: if isSignedIn(); allow write: if isCouncil(); }
    // 여기 없는 shared/* 문서는 기본적으로 아무도 못 읽고 못 쓴다(새 문서를 만들 땐
    // 위에 규칙을 같이 추가해야 한다). 서버(GitHub Actions)는 Admin SDK라 규칙과 무관하게 쓴다.
  }
}
