# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# 배포용 빌드 결과물 — build-dist.mjs가 public/에서 주석을 지워 매번 새로 만든다
dist/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# Android 빌드 산출물/로컬 환경설정 (기기마다 다르고 용량이 커서 커밋 대상 아님)
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/google-services.json

# Firebase 서비스 계정 키 — 절대 커밋 금지, GitHub Actions Secret으로만 전달
*serviceAccount*.json
*service-account*.json

# Gemini API 키 등 실제 비밀값 — Public 저장소라 커밋하면 GitHub가 구글에 신고해서
# 자동 폐기당한다. build-dist.mjs가 빌드 시점(dist/에만)에 이 파일 내용을 끼워 넣는다.
secrets.local.json

# 앱 서명 키 — 절대 커밋 금지. 별도로 안전한 곳에 백업할 것
# (잃어버리면 같은 앱으로 업데이트를 배포할 수 없음)
*.keystore
*.jks
android/keystore.properties

# 배포용 APK — 용량이 커서 git에 넣지 않음 (호스팅에만 업로드)
public/*.apk

# Playwright MCP가 브라우저 확인 중 생성하는 임시 스냅샷/로그
public/.playwright-mcp/
